Class QueueLinkedList {
 Node front, rear;
 Class Node {
 Int data;
 Node next;
 Node(int data) {
 This.data = data;
 This.next = null;
 }
 }
 Void enqueue(int data) {
 Node newNode = new Node(data);
 If (rear == null) {
 Front = rear = newNode;
 } else {
 Rear.next = newNode;
 Rear = newNode;
 }
 }
 Void dequeue() {
 If (front == null) {
 System.out.println(“Queue is Empty”);
 } else {
 System.out.println(“Deleted: “ + front.data);
 Front = front.next;
 If (front == null) {
 Rear = null;
 }
 }
 }
 Void display() {
 Node temp = front;
 While (temp != null) {
 System.out.println(temp.data);
 Temp = temp.next;
 }
 }
 Public static void main(String[] args) {
 QueueLinkedList q = new QueueLinkedList();
 q.enqueue(10);
 q.enqueue(20);
 q.enqueue(30);
